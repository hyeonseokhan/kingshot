---
// 헤더 안 후원 버튼 + 다이얼로그. LoginedUserInfo 좌측에 배치.
// PC: "☕️ 후원하기", 모바일: "☕️ 후원" — CSS 로 라벨 swap.
// 클릭 시 native <dialog> 로 안내문 + [바로가기]/[닫기] 노출. backdrop / ESC 자동.
//
// 동작 로직: src/scripts/components/support-button.ts
---

<button
  class="support-btn"
  id="support-btn"
  type="button"
  aria-label="후원"
  data-i18n-attr-aria-label="header.support"
>
  <span class="support-label-pc" data-i18n="header.support">☕️ 후원하기</span>
  <span class="support-label-mobile" data-i18n="header.supportShort">☕️ 후원</span>
</button>

<dialog class="support-dialog" id="support-dialog" aria-labelledby="support-dialog-title">
  <div class="support-dialog-card">
    <div class="support-dialog-hero" aria-hidden="true">☕</div>
    <h3
      class="support-dialog-title"
      id="support-dialog-title"
      data-i18n="header.supportTitle"
    >
      관리자 후원
    </h3>
    <p class="support-dialog-tagline" data-i18n="header.supportTagline">
      커피 한 잔의 선물로 관리자에게 큰 힘이 됩니다
    </p>
    <div class="support-dialog-actions">
      <a
        class="btn btn-primary support-dialog-link"
        href="https://qr.kakaopay.com/281006011000024387843562"
        target="_blank"
        rel="noopener noreferrer"
      >
        <span data-i18n="header.supportLink">바로가기</span>
        <span class="support-dialog-link-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" focusable="false">
            <path
              d="M12 3C6.48 3 2 6.48 2 10.8c0 2.76 1.92 5.16 4.8 6.6L5.4 22l4.92-2.88c.54.12 1.14.18 1.68.18 5.52 0 10-3.48 10-7.8S17.52 3 12 3z"
              fill="#1a1a1a"
            />
          </svg>
          Pay
        </span>
      </a>
      <button
        class="btn btn-secondary support-dialog-close"
        id="support-dialog-close"
        type="button"
        data-i18n="common.close"
      >
        닫기
      </button>
    </div>
  </div>
</dialog>

<script>
  import '@/scripts/components/support-button';
</script>

<style>
  /* === 헤더 버튼 — Amber Glow ===
     margin-left:auto 로 우측 끝까지 떠밀려 LoginedUserInfo 와 인접.
     LoginedUserInfo 의 margin-left 는 0 으로 설정되어 본 버튼과 자연스럽게 붙음.
     높이는 .hu-trigger (avatar 26px + padding 3+3 = 32px) 와 시각 정렬.
     은은한 amber glow 가 2.4s 주기로 깜박 — 후원 트리거임을 부담 없이 시각 강조. */
  .support-btn {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    height: 32px;
    background: rgba(184, 115, 51, 0.18);
    border: 1px solid rgba(184, 115, 51, 0.5);
    color: #fff7ec;
    border-radius: 999px;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 600;
    font-family: var(--font);
    cursor: pointer;
    line-height: 1;
    transition: background 0.15s, border-color 0.15s;
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(184, 115, 51, 0.2);
    animation: support-btn-glow 2.4s ease-in-out infinite;
  }
  .support-btn:hover {
    background: rgba(184, 115, 51, 0.32);
    border-color: rgba(184, 115, 51, 0.7);
  }
  @keyframes support-btn-glow {
    0%, 100% { box-shadow: 0 0 0 0 rgba(184, 115, 51, 0.2); }
    50% { box-shadow: 0 0 10px 0 rgba(184, 115, 51, 0.3); }
  }
  /* 접근성 — 사용자가 reduced motion 켜놨으면 깜박임 disable. */
  @media (prefers-reduced-motion: reduce) {
    .support-btn {
      animation: none;
    }
  }

  /* PC: 긴 라벨, 모바일: 짧은 라벨 */
  .support-label-mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .support-btn {
      height: 28px;
      padding: 0 10px;
      font-size: 12px;
      /* 모바일에선 mobile-menu-btn / LangSwitcher 도 같은 row 에 — gap 으로 충분히 분리됨 */
    }
    .support-label-pc {
      display: none;
    }
    .support-label-mobile {
      display: inline;
    }
  }

  /* === 다이얼로그 — Cozy Coffee 톤 ===
     베이지→흰 그라데이션 카드 + 큰 ☕ 헤더 + 진한 브라운 강조.
     `var(--bg)`/`var(--text)` 대신 명시 색 (다크모드 무관 cozy 톤 유지). */
  .support-dialog {
    /* native <dialog>[open] 은 position:fixed 가 user-agent default. inset:0 + margin:auto
       로 viewport 정중앙 정렬 — UA 별 차이 보정. */
    position: fixed;
    inset: 0;
    margin: auto;
    border: none;
    padding: 0;
    border-radius: 16px;
    background: linear-gradient(180deg, #fff7ec 0%, #fff 60%);
    color: #1f2125;
    max-width: 380px;
    width: calc(100% - 32px);
    max-height: calc(100% - 32px);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.32);
  }
  .support-dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
  }

  .support-dialog-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 24px 24px 20px;
  }

  /* ☕ 큰 헤더 — drop-shadow 로 살짝 떠 있는 느낌, cozy 톤의 시각 강조 */
  .support-dialog-hero {
    font-size: 44px;
    line-height: 1;
    margin-top: 4px;
    filter: drop-shadow(0 4px 10px rgba(120, 80, 40, 0.2));
  }

  .support-dialog-title {
    margin: 0;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #5d3a1a;
  }

  /* 문구 — 베이지 브라운, italic 유지 (cozy 친근함) */
  .support-dialog-tagline {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
    text-align: center;
    color: #846246;
    font-style: italic;
    letter-spacing: -0.005em;
    max-width: 280px;
  }

  /* 액션 row — [바로가기] [닫기] 양쪽으로. 모바일에서도 row 유지 (버튼 짧음). */
  .support-dialog-actions {
    display: flex;
    gap: 10px;
    margin-top: 4px;
    width: 100%;
    justify-content: center;
  }
  .support-dialog-actions .btn {
    min-width: 110px;
  }
  /* <a class="btn"> 시 기본 underline / 색 제거. button 과 시각 일치.
     primary 그라데이션은 cozy 톤에 맞춰 커피 브라운 으로 override (기본 orange→red 보다 톤 일관).
     position:relative — 좌측 상단 카카오페이 배지 absolute 기준. */
  .support-dialog-link {
    position: relative;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #b87333 0%, #6f4923 100%);
    box-shadow: 0 4px 12px rgba(111, 73, 35, 0.32);
  }
  .support-dialog-link:hover {
    background: linear-gradient(135deg, #a06129 0%, #5a3a1c 100%);
  }

  /* 카카오페이 배지 — 좌측 상단, 노란 알약 (카카오톡 말풍선 + Pay). */
  .support-dialog-link-badge {
    position: absolute;
    top: -8px;
    left: -10px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px 4px 6px;
    background: #fee500;
    color: #1a1a1a;
    font-size: 10px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0.04em;
    border-radius: 999px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }
  .support-dialog-link-badge svg {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    display: block;
  }

  @media (max-width: 480px) {
    .support-dialog-card {
      padding: 20px 18px 16px;
      gap: 12px;
    }
    .support-dialog-tagline {
      font-size: 12.5px;
    }
  }
</style>
