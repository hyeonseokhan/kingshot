---
import AppLayout from '@/layouts/AppLayout.astro';
import { tabs, findActiveSubmenu } from '@/data/navigation';
import '@/styles/game-tools.css';

const gameTools = tabs.find((t) => t.id === 'game-tools')!;
const active = findActiveSubmenu(gameTools, Astro.url.pathname);
const navItems = gameTools.submenus!.map((s) => ({
  title: s.title,
  titleKey: s.titleKey,
  path: s.path,
  active: active?.id === s.id,
}));
---

<AppLayout
  title="부대 계산기 — PNX 연맹"
  description="곰 사냥 출정 전 보유 병력으로 N개 편대 분배를 계산"
  navHeader={gameTools.title}
  navHeaderKey={gameTools.titleKey}
  navItems={navItems}
>
  <div
    class="manage-page tc-page"
    id="page-troops-calculator"
    data-gated-kingshot-id="270680423"
  >
    <div class="members-header">
      <h1 data-i18n="gameTools.troopsCalculator.heading">부대 계산기</h1>
      <span class="tc-mode-badge">🐻 Bear Hunt · 1 : 1 : 8</span>
    </div>

    <!-- 프로필 슬롯 1~5 — 여러 계정 보유 병력/설정을 저장해두고 한 번에 불러오기.
         슬롯 클릭: 불러오기(데이터 있으면) / 빈 슬롯이면 현재 입력을 그 슬롯에 저장.
         long-press 또는 ✕ 로 삭제. DB(troops_profiles) 영속 — 브라우저 무관. -->
    <div class="tc-profiles" id="tc-profiles">
      <span class="tc-profiles-label" data-i18n="gameTools.troopsCalculator.profilesLabel">프로필</span>
      <div class="tc-profile-slots" id="tc-profile-slots">
        <!-- JS 가 5개 슬롯 렌더 -->
      </div>
    </div>

    <form class="tc-form" id="tc-form" autocomplete="off" novalidate>
      <!-- 병과별 T9/T10 분리 입력. 각 행: 라벨 + T10 + T9. (T10 이 더 강해서 좌측 우선) -->
      <div class="tc-troops-grid">
        <span class="tc-troops-head tc-troops-head-label"></span>
        <span class="tc-troops-head">T10</span>
        <span class="tc-troops-head">T9</span>

        <label class="tc-troops-label" data-i18n="gameTools.troopsCalculator.labelInfantry">보병</label>
        <input
          type="text"
          name="infantryT10"
          inputmode="numeric"
          data-tc-number
          data-i18n-attr-placeholder="gameTools.troopsCalculator.placeholderNumber"
          placeholder="숫자 입력"
          aria-label="보병 T10"
        />
        <input
          type="text"
          name="infantryT9"
          inputmode="numeric"
          data-tc-number
          data-i18n-attr-placeholder="gameTools.troopsCalculator.placeholderNumber"
          placeholder="숫자 입력"
          aria-label="보병 T9"
        />

        <label class="tc-troops-label" data-i18n="gameTools.troopsCalculator.labelCavalry">기병</label>
        <input
          type="text"
          name="cavalryT10"
          inputmode="numeric"
          data-tc-number
          data-i18n-attr-placeholder="gameTools.troopsCalculator.placeholderNumber"
          placeholder="숫자 입력"
          aria-label="기병 T10"
        />
        <input
          type="text"
          name="cavalryT9"
          inputmode="numeric"
          data-tc-number
          data-i18n-attr-placeholder="gameTools.troopsCalculator.placeholderNumber"
          placeholder="숫자 입력"
          aria-label="기병 T9"
        />

        <label class="tc-troops-label" data-i18n="gameTools.troopsCalculator.labelArchers">궁병</label>
        <input
          type="text"
          name="archersT10"
          inputmode="numeric"
          data-tc-number
          data-i18n-attr-placeholder="gameTools.troopsCalculator.placeholderNumber"
          placeholder="숫자 입력"
          aria-label="궁병 T10"
        />
        <input
          type="text"
          name="archersT9"
          inputmode="numeric"
          data-tc-number
          data-i18n-attr-placeholder="gameTools.troopsCalculator.placeholderNumber"
          placeholder="숫자 입력"
          aria-label="궁병 T9"
        />
      </div>

      <!-- 설정 행: 출정 상한 / 편대 수 / 분배 비율 -->
      <div class="tc-settings-grid">
        <label class="tc-field">
          <span data-i18n="gameTools.troopsCalculator.labelCap">출정 상한 값</span>
          <input
            type="text"
            name="cap"
            inputmode="numeric"
            data-tc-number
            data-i18n-attr-placeholder="gameTools.troopsCalculator.placeholderNumber"
            placeholder="숫자 입력"
            required
          />
        </label>
        <label class="tc-field">
          <span data-i18n="gameTools.troopsCalculator.labelSquadCount">운영 편대 수</span>
          <select name="squadCount">
            <option value="1">1</option>
            <option value="2" selected>2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
          </select>
        </label>
        <label class="tc-field">
          <span data-i18n="gameTools.troopsCalculator.labelDistribution">분배 비율</span>
          <select name="distribution">
            <option value="bear" selected data-i18n="gameTools.troopsCalculator.distributionBear">권장값 (1:1:8)</option>
            <option value="bear-stack" data-i18n="gameTools.troopsCalculator.distributionStack">몰빵형 (1편대 우선 1:1:8)</option>
            <option value="even" data-i18n="gameTools.troopsCalculator.distributionEven">균등</option>
          </select>
        </label>
      </div>

      <div class="tc-actions">
        <button type="submit" class="btn btn-primary" data-i18n="gameTools.troopsCalculator.btnCalculate">
          계산
        </button>
        <button type="button" class="btn btn-secondary" id="tc-reset" data-i18n="gameTools.troopsCalculator.btnReset">
          초기화
        </button>
        <button type="button" class="btn btn-secondary" id="tc-save-profile" data-i18n="gameTools.troopsCalculator.btnSaveProfile">
          프로필 저장
        </button>
      </div>

      <div class="tc-error" id="tc-error" role="alert" hidden></div>
    </form>

    <!-- 프로필 저장 슬롯 선택 다이얼로그. native <dialog> — 절대 룰: 화면 중앙 고정. -->
    <dialog class="tc-profile-dialog" id="tc-profile-dialog">
      <div class="tc-profile-dialog-inner">
        <h2 class="tc-profile-dialog-title" data-i18n="gameTools.troopsCalculator.saveDialogTitle">
          어느 슬롯에 저장할까요?
        </h2>
        <p class="tc-profile-dialog-desc" data-i18n="gameTools.troopsCalculator.saveDialogDesc">
          현재 입력값을 선택한 슬롯에 저장합니다. 이미 값이 있으면 덮어씁니다.
        </p>
        <label class="tc-profile-name-field">
          <span data-i18n="gameTools.troopsCalculator.saveDialogNameLabel">프로필 이름 (선택)</span>
          <input
            type="text"
            id="tc-profile-name"
            maxlength="40"
            data-i18n-attr-placeholder="gameTools.troopsCalculator.saveDialogNamePlaceholder"
            placeholder="예: 본캐 / 부캐2"
          />
        </label>
        <div class="tc-profile-slot-picker" id="tc-profile-slot-picker">
          <!-- JS 가 슬롯 5개 버튼 렌더 -->
        </div>
        <div class="tc-profile-dialog-actions">
          <button type="button" class="btn btn-secondary" id="tc-profile-cancel" data-i18n="gameTools.troopsCalculator.saveDialogCancel">
            취소
          </button>
        </div>
      </div>
    </dialog>

    <section class="tc-result" id="tc-result" hidden>
      <div class="tc-result-head">
        <span class="tc-result-mode" id="tc-mode-text"></span>
        <span class="tc-result-ratio" id="tc-ratio-text"></span>
      </div>
      <div class="tc-table-wrap">
        <table class="tc-table tc-table-tier">
          <thead>
            <tr>
              <th data-i18n="gameTools.troopsCalculator.tableSquad">편대</th>
              <th data-i18n="gameTools.troopsCalculator.tableInfantry">보병</th>
              <th data-i18n="gameTools.troopsCalculator.tableCavalry">기병</th>
              <th data-i18n="gameTools.troopsCalculator.tableArchers">궁병</th>
              <th data-i18n="gameTools.troopsCalculator.tableTotal">합계</th>
            </tr>
          </thead>
          <tbody id="tc-table-body"></tbody>
        </table>
      </div>
      <p class="tc-tier-hint" data-i18n="gameTools.troopsCalculator.tierHint">
        T10/T9 숫자를 각각 탭하면 그 값만 복사됩니다.
      </p>
    </section>

    <p class="tc-future-note">
      <span data-i18n="gameTools.troopsCalculator.vikingsHint">Vikings 부대 계산기 · 추후 업데이트</span>
    </p>

    <div class="gt-no-permission" id="tc-no-permission" hidden>
      <p data-i18n="gameTools.troopsCalculator.noPermission">
        이 도구는 권한이 있는 사용자만 사용할 수 있습니다.
      </p>
    </div>

    <!-- 화면 가운데 토스트 — 셀 클릭 시 "복사되었습니다" 표시. 타일매치 .tm-toast 패턴 동일. -->
    <div class="tc-toast" id="tc-toast" role="status" aria-live="polite"></div>
  </div>

  <script>
    import '@/scripts/pages/game-tools-guard';
    import '@/scripts/pages/game-tools-troops-calculator';
  </script>
</AppLayout>
