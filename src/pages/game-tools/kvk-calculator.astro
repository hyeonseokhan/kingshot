---
import AppLayout from '@/layouts/AppLayout.astro';
import { tabs, findActiveSubmenu } from '@/data/navigation';
import '@/styles/game-tools.css';

const gameTools = tabs.find((t) => t.id === 'game-tools')!;
const active = findActiveSubmenu(gameTools, Astro.url.pathname);
const navItems = gameTools.submenus!.map((s) => ({
  title: s.title,
  titleKey: s.titleKey,
  path: s.path,
  active: active?.id === s.id,
}));
---

<AppLayout
  title="KvK 계산기 — PNX 연맹"
  description="30T 달성을 위한 병사 5:2:3 + 건물 가속권 종합 계산"
  navHeader={gameTools.title}
  navHeaderKey={gameTools.titleKey}
  navItems={navItems}
>
  <div
    class="manage-page kvk-page"
    id="page-kvk-calculator"
    data-gated-kingshot-id="270680423"
  >
    <div class="members-header">
      <h1 data-i18n="gameTools.kvkCalculator.heading">KvK 계산기</h1>
      <span class="tc-mode-badge" data-i18n="gameTools.kvkCalculator.modeBadge">🏰 30T · 5:2:3</span>
    </div>

    <div class="kvk-layout">

      <!-- ── 왼쪽: 입력 사이드바 ── -->
      <div class="kvk-sidebar">

        <!-- 병사 + 가속권: 한 박스 2컬럼 -->
        <div class="kvk-sidebar-section">
          <div class="kvk-2col-header">
            <span data-i18n="gameTools.kvkCalculator.groupTroops">보유 병사</span>
            <span data-i18n="gameTools.kvkCalculator.groupAccel">가속권 (분)</span>
          </div>
          <form class="kvk-form" id="kvk-form" autocomplete="off" novalidate>
            <div class="kvk-2col-grid">
              <!-- 보병 / 공용 -->
              <div class="kvk-field">
                <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelInfantry">보병</span></label>
                <input type="text" name="infantry" inputmode="numeric" data-kvk-number value="140043" />
              </div>
              <div class="kvk-field">
                <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelAccelCommon">공용</span></label>
                <input type="text" name="accelCommon" inputmode="numeric" data-kvk-number value="62742" />
                <small class="kvk-dhm" data-dhm-for="accelCommon"></small>
              </div>
              <!-- 기병 / 병사훈련 -->
              <div class="kvk-field">
                <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelCavalry">기병</span></label>
                <input type="text" name="cavalry" inputmode="numeric" data-kvk-number value="102670" />
              </div>
              <div class="kvk-field">
                <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelAccelTraining">병사훈련</span></label>
                <input type="text" name="accelTraining" inputmode="numeric" data-kvk-number value="34412" />
                <small class="kvk-dhm" data-dhm-for="accelTraining"></small>
              </div>
              <!-- 궁병 / 건설 -->
              <div class="kvk-field">
                <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelArchers">궁병</span></label>
                <input type="text" name="archers" inputmode="numeric" data-kvk-number value="131579" />
              </div>
              <div class="kvk-field">
                <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelAccelBuilding">건설</span></label>
                <input type="text" name="accelBuilding" inputmode="numeric" data-kvk-number value="4005" />
                <small class="kvk-dhm" data-dhm-for="accelBuilding"></small>
              </div>
            </div>

            <!-- 건설 상태 -->
            <div class="kvk-sidebar-section kvk-sidebar-section-inner">
              <div class="kvk-section-label" data-i18n="gameTools.kvkCalculator.groupBuilding">건설 상태</div>
              <div class="kvk-static-row">
                <span data-i18n="gameTools.kvkCalculator.labelEmbassyRemaining">대사관 28→29 잔여(분)</span>
                <span class="kvk-static-value" id="kvk-embassy-display"></span>
              </div>
              <input type="hidden" name="embassyRemaining" value="8967" />
              <input type="hidden" name="embassyMeasuredAt" value="2026-05-20T16:01:00+09:00" />
            </div>

            <!-- 마감 · 추가 획득 -->
            <div class="kvk-sidebar-section kvk-sidebar-section-inner">
              <div class="kvk-section-label" data-i18n="gameTools.kvkCalculator.groupDeadline">마감 · 추가 획득</div>
              <div class="kvk-field">
                <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelDeadline">마감 일시 (KST)</span></label>
                <input type="datetime-local" name="deadline" value="2026-05-23T15:00" />
              </div>
              <div class="kvk-2col-grid kvk-2col-grid-sm">
                <div class="kvk-field">
                  <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelBonus3h">3시간권 (개)</span></label>
                  <input type="text" name="bonusH3" inputmode="numeric" data-kvk-number value="36" />
                </div>
                <div class="kvk-field">
                  <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelBonus1h">1시간권 (개)</span></label>
                  <input type="text" name="bonusH1" inputmode="numeric" data-kvk-number value="30" />
                </div>
                <div class="kvk-field">
                  <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelBonus5m">5분권 (개)</span></label>
                  <input type="text" name="bonusM5" inputmode="numeric" data-kvk-number value="216" />
                </div>
                <div class="kvk-field">
                  <label class="kvk-field-label"><span data-i18n="gameTools.kvkCalculator.labelBonus1m">1분권 (개)</span></label>
                  <input type="text" name="bonusM1" inputmode="numeric" data-kvk-number value="180" />
                </div>
              </div>
            </div>

          </form>
        </div>

      </div>

      <!-- ── 오른쪽: 결과 ── -->
      <div class="kvk-results">

        <!-- 가능여부 -->
        <div class="kvk-feasibility-inline" id="kvk-feasibility-inline">
          <div class="kvk-feasibility-title" data-i18n="gameTools.kvkCalculator.cardFeasibility">⚡ 30T 가능여부</div>
          <table class="kvk-table">
            <tbody id="kvk-feasibility-rows"></tbody>
          </table>
        </div>

        <div class="kvk-card">
          <div class="kvk-card-head" data-i18n="gameTools.kvkCalculator.cardTraining">병사 훈련 (5:2:3 달성)</div>
          <div class="kvk-card-body">
            <table class="kvk-table">
              <tbody id="kvk-training-target"></tbody>
            </table>
            <div class="kvk-accel-wrap">
              <table class="kvk-table kvk-table-accel">
                <colgroup>
                  <col class="col-type" />
                  <col class="col-have" />
                  <col class="col-use" />
                  <col class="col-remain" />
                </colgroup>
                <thead>
                  <tr>
                    <th data-i18n="gameTools.kvkCalculator.thType">종류</th>
                    <th data-i18n="gameTools.kvkCalculator.thHave">보유</th>
                    <th data-i18n="gameTools.kvkCalculator.thUse">사용</th>
                    <th data-i18n="gameTools.kvkCalculator.thRemain">잔여</th>
                  </tr>
                </thead>
                <tbody id="kvk-training-accel"></tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="kvk-card">
          <div class="kvk-card-head" data-i18n="gameTools.kvkCalculator.cardBuilding">건물 30T (단일 슬롯 즉시완료)</div>
          <div class="kvk-card-body">
            <table class="kvk-table">
              <tbody id="kvk-building-rows"></tbody>
            </table>
          </div>
        </div>

        <details class="kvk-constants-details">
          <summary class="kvk-constants-summary" data-i18n="gameTools.kvkCalculator.sectionConstants">🔒 상수 (참고)</summary>
          <div class="kvk-card kvk-card-constants">
            <table class="kvk-table">
              <tbody id="kvk-constants-rows"></tbody>
            </table>
          </div>
        </details>

        <p class="kvk-footer">
          <span data-i18n="gameTools.kvkCalculator.footerNote">입력값은 브라우저에 자동 저장됩니다. 사이트 계산기: </span>
          <a href="https://kingshotdata.kr/calc-training" target="_blank" rel="noopener noreferrer" data-i18n="gameTools.kvkCalculator.siteCalcLink">kingshotdata.kr</a>
        </p>

      </div>
    </div>

    <div class="gt-no-permission" id="kvk-no-permission" hidden>
      <p data-i18n="gameTools.kvkCalculator.noPermission">
        이 도구는 권한이 있는 사용자만 사용할 수 있습니다.
      </p>
    </div>
  </div>

  <script>
    import '@/scripts/pages/game-tools-guard';
    import '@/scripts/pages/game-tools-kvk-calculator';
  </script>
</AppLayout>
