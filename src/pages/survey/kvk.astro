---
import SurveyLayout from '@/layouts/SurveyLayout.astro';
import '@/styles/survey-kvk.css';
---

<SurveyLayout
  title="KVK 가속권 현황 조사 — Kingshot"
  description="KVK 이벤트 대비 가속권 보유 현황을 조사하는 페이지입니다"
>
  <div class="sk-page" id="sk-page">
    <section class="sk-intro">
      <p data-i18n="survey.kvk.intro">
        KVK 이벤트를 앞두고 가속권 보유 현황을 공유해 주세요.
      </p>
    </section>

    <!-- 상시 안내 — 자격 / 열람 권한 / 보상 / 가속권 사용 -->
    <section class="sk-notice">
      <ul>
        <li data-i18n="survey.kvk.notice.line1">제출을 완료한 사용자만 현황을 열람할 수 있습니다.</li>
        <li data-i18n-html="survey.kvk.notice.line2">등록은 <strong>TC 레벨 26 이상</strong> 사용자만 가능합니다.</li>
        <li data-i18n-html="survey.kvk.notice.reward"><strong>상위 48명 보상</strong>: 1일차(건설) / 4일차(병사) 국왕스킬을 30분씩 순차 로테이션 (24시간).</li>
        <li data-i18n-html="survey.kvk.notice.usage"><strong>가속권은 모두 KvK 점수에 투입</strong>해 주세요. 과도 보유 / 허위 제출 시 <strong class="sk-notice-warn">패널티가 부과</strong>됩니다.</li>
      </ul>
    </section>

    <!-- (A) 시작 다이얼로그 — ID 입력 + 본인 확인 + PIN -->
    <dialog class="sk-dialog" id="sk-auth-dialog" aria-labelledby="sk-auth-title">
      <div class="sk-dialog-card">
        <header class="sk-dialog-head">
          <strong id="sk-auth-title" data-i18n="survey.kvk.auth.title">시작하기</strong>
          <button
            type="button"
            class="sk-dialog-close"
            id="sk-auth-close"
            aria-label="Close"
          >&times;</button>
        </header>
        <div class="sk-dialog-body">
          <!-- Step 1: ID 입력 -->
          <div class="sk-step" id="sk-step-id">
            <label
              for="sk-id-input"
              class="sk-label"
              data-i18n="survey.kvk.auth.idLabel"
            >킹샷 ID</label>
            <div class="sk-input-row">
              <input
                type="text"
                id="sk-id-input"
                inputmode="numeric"
                autocomplete="off"
                placeholder="예: 270680423"
                data-i18n-attr-placeholder="survey.kvk.auth.idPlaceholder"
              />
              <button
                type="button"
                class="sk-btn sk-btn-primary"
                id="sk-id-search"
                data-i18n="survey.kvk.auth.searchButton"
              >조회</button>
            </div>
            <div class="sk-status" id="sk-id-status" role="status" aria-live="polite"></div>
          </div>

          <!-- Step "blocked": TC 레벨 26 미만 — 등록 불가 안내 후 닫기 -->
          <div class="sk-step sk-step-blocked" id="sk-step-blocked" hidden>
            <div class="sk-blocked-icon">⛔</div>
            <h4 class="sk-blocked-title" data-i18n="survey.kvk.blocked.title">
              설문에 참여할 수 없는 대상입니다
            </h4>
            <p class="sk-blocked-body" data-i18n-html="survey.kvk.blocked.body">
              TC 레벨 <strong>26 이상</strong> 사용자만 등록 가능합니다.
            </p>
            <p class="sk-blocked-current" id="sk-blocked-current">현재 레벨: TC -</p>
            <div class="sk-dialog-actions">
              <button
                type="button"
                class="sk-btn sk-btn-primary"
                id="sk-blocked-close"
                data-i18n="survey.kvk.blocked.closeButton"
              >닫기</button>
            </div>
          </div>

          <!-- Step 2: 본인 확인 -->
          <div class="sk-step" id="sk-step-confirm" hidden>
            <div class="sk-player-card" id="sk-player-card">
              <div class="sk-player-photo-wrap">
                <div class="sk-player-photo-empty" id="sk-player-photo-empty">?</div>
                <img class="sk-player-photo" id="sk-player-photo" src="" alt="" hidden />
              </div>
              <div class="sk-player-meta">
                <div class="sk-player-name" id="sk-player-name">-</div>
                <div class="sk-player-id" id="sk-player-id">-</div>
              </div>
            </div>
            <p class="sk-help" data-i18n="survey.kvk.auth.confirmHelp">
              본인이 맞으면 PIN 4자리를 입력해 주세요. (신규는 새 PIN 설정, 기존이면 등록한 PIN)
            </p>
            <div class="sk-pin-header">
              <span class="sk-label" data-i18n="survey.kvk.auth.pinLabel">PIN 4자리</span>
              <span class="sk-pin-hint" id="sk-pin-hint" data-i18n="survey.kvk.auth.pinHintNew">
                신규 등록 — 새 PIN 으로 사용됩니다
              </span>
            </div>
            <div class="sk-pin-wrap" id="sk-pin-wrap">
              <!-- 보이지 않는 단일 input + 위에 겹쳐진 4개의 box (tile-match-auth 패턴 차용).
                   input 의 value 길이에 따라 box 채움 표시. -->
              <input
                class="sk-pin-input"
                id="sk-pin-input"
                type="text"
                inputmode="numeric"
                pattern="[0-9]*"
                maxlength="4"
                autocomplete="off"
                autocapitalize="off"
                autocorrect="off"
                spellcheck="false"
                aria-label="PIN 4자리 입력"
                data-i18n-attr-aria-label="auth.pinInputAria"
              />
              <div class="sk-pin-boxes" id="sk-pin-boxes" aria-hidden="true">
                <div class="sk-pin-box"></div>
                <div class="sk-pin-box"></div>
                <div class="sk-pin-box"></div>
                <div class="sk-pin-box"></div>
              </div>
            </div>
            <div class="sk-status" id="sk-pin-status" role="status" aria-live="polite"></div>
            <div class="sk-dialog-actions">
              <button
                type="button"
                class="sk-btn sk-btn-secondary"
                id="sk-pin-back"
                data-i18n="common.back"
              >뒤로</button>
              <button
                type="button"
                class="sk-btn sk-btn-primary"
                id="sk-pin-confirm"
                data-i18n="common.confirm"
              >확인</button>
            </div>
          </div>
        </div>
      </div>
    </dialog>

    <!-- (B) 폼 다이얼로그 (PIN 인증 후 또는 로그인된 사용자가 [등록/수정] 클릭 시 노출) -->
    <dialog class="sk-dialog sk-form-dialog" id="sk-form-dialog" aria-labelledby="sk-form-title">
      <div class="sk-dialog-card">
        <header class="sk-dialog-head">
          <strong id="sk-form-title" data-i18n="survey.kvk.form.dialogTitle"
            >내 정보 등록 / 수정</strong
          >
          <button
            type="button"
            class="sk-dialog-close"
            id="sk-form-close"
            aria-label="Close"
          >&times;</button>
        </header>
        <div class="sk-dialog-body">
          <div class="sk-player-card sk-player-card-compact" id="sk-form-player">
            <div class="sk-player-photo-wrap">
              <div class="sk-player-photo-empty" id="sk-form-photo-empty">?</div>
              <img class="sk-player-photo" id="sk-form-photo" src="" alt="" hidden />
            </div>
            <div class="sk-player-meta">
              <div class="sk-player-name" id="sk-form-name">-</div>
              <div class="sk-player-id" id="sk-form-id">-</div>
            </div>
          </div>
          <p class="sk-help">
            <span data-i18n="survey.kvk.form.help"
              >게임 내 가속권 현황 상태에서 분 단위로 설정한 값을 입력해주세요</span
            >
            <button
              type="button"
              class="sk-help-image-trigger"
              id="sk-help-image-trigger"
              data-i18n="survey.kvk.form.helpImageLink"
            >이미지 보기</button>
          </p>
          <div class="sk-form-warn" role="note">
            <span class="sk-form-warn-icon" aria-hidden="true">⚠️</span>
            <span data-i18n="survey.kvk.form.warn"
              >허위 정보를 제출한 경우, KvK 종료 후 패널티가 부과됩니다.</span
            >
          </div>
          <div class="sk-form-rows">
            <!-- 시간 row — select. UTC 기준 30분 단위 48개 옵션은 클라이언트 JS 에서 동적 생성. -->
            <div class="sk-form-row sk-form-row-time">
              <span class="sk-form-row-prefix">
                <span class="sk-form-row-prefix-emoji" aria-hidden="true">🕐</span>
                <span data-i18n="survey.kvk.form.preferredTimeLabel">버프 시간 (UTC)</span>
              </span>
              <select
                id="sk-input-preferred-time"
                aria-label="버프 시간 (UTC)"
                data-i18n-attr-aria-label="survey.kvk.form.preferredTimeLabel"
              >
                <!-- placeholder option + 48개 시간 옵션은 JS init() 에서 채움 -->
              </select>
            </div>
            <!-- 가속권 3개 — input.num 자체가 컨테이너, prefix(좌) + unit(우) absolute overlay -->
            <div class="sk-form-row">
              <span class="sk-form-row-prefix">
                <span class="sk-form-row-prefix-emoji" aria-hidden="true">⭐</span>
                <span data-i18n="survey.kvk.list.thead.general">공용</span>
              </span>
              <input
                type="text"
                id="sk-input-general"
                class="sk-form-row-input"
                inputmode="numeric"
                autocomplete="off"
                placeholder="예: 16,767"
                data-i18n-attr-placeholder="survey.kvk.form.placeholderGeneral"
              />
              <span class="sk-form-row-unit" data-i18n="survey.kvk.form.unit">분</span>
            </div>
            <div class="sk-form-row">
              <span class="sk-form-row-prefix">
                <span class="sk-form-row-prefix-emoji" aria-hidden="true">🛡️</span>
                <span data-i18n="survey.kvk.list.thead.training">병사</span>
              </span>
              <input
                type="text"
                id="sk-input-training"
                class="sk-form-row-input"
                inputmode="numeric"
                autocomplete="off"
                placeholder="예: 11,943"
                data-i18n-attr-placeholder="survey.kvk.form.placeholderTraining"
              />
              <span class="sk-form-row-unit" data-i18n="survey.kvk.form.unit">분</span>
            </div>
            <div class="sk-form-row">
              <span class="sk-form-row-prefix">
                <span class="sk-form-row-prefix-emoji" aria-hidden="true">🔨</span>
                <span data-i18n="survey.kvk.list.thead.construction">건설</span>
              </span>
              <input
                type="text"
                id="sk-input-construction"
                class="sk-form-row-input"
                inputmode="numeric"
                autocomplete="off"
                placeholder="예: 11,709"
                data-i18n-attr-placeholder="survey.kvk.form.placeholderConstruction"
              />
              <span class="sk-form-row-unit" data-i18n="survey.kvk.form.unit">분</span>
            </div>
          </div>
          <div class="sk-status" id="sk-form-status" role="status" aria-live="polite"></div>
          <div class="sk-form-actions">
            <!-- 삭제: 수정 모드일 때만 노출 (JS 가 enterFormMode 에서 hidden 토글). 좌측 끝. -->
            <button
              type="button"
              class="sk-btn sk-btn-danger"
              id="sk-form-delete"
              hidden
              data-i18n="survey.kvk.form.deleteButton"
            >삭제</button>
            <!-- 취소 + 저장 — 우측 페어 (Cancel margin-left: auto 로 우측 push) -->
            <button
              type="button"
              class="sk-btn sk-btn-secondary"
              id="sk-form-cancel"
              data-i18n="survey.kvk.form.cancelButton"
            >취소</button>
            <button
              type="button"
              class="sk-btn sk-btn-primary"
              id="sk-form-save"
              data-i18n="common.save"
            >저장</button>
          </div>
        </div>
      </div>
    </dialog>

    <!-- (C) 목록 영역 — 인증 전엔 잠금 placeholder, 인증 후 .sk-page.is-unlocked 로 노출 -->
    <section class="sk-list-section">
      <header class="sk-list-head">
        <h3 data-i18n="survey.kvk.list.heading">제출 현황</h3>
        <div class="sk-list-toolbar">
          <span class="sk-list-count" id="sk-list-count"></span>
          <input
            type="search"
            class="sk-list-search"
            id="sk-list-search"
            autocomplete="off"
            placeholder="닉네임 또는 ID 검색"
            data-i18n-attr-placeholder="survey.kvk.list.searchPlaceholder"
            aria-label="닉네임 또는 ID 검색"
            data-i18n-attr-aria-label="survey.kvk.list.searchPlaceholder"
          />
          <button
            type="button"
            class="sk-icon-btn"
            id="sk-list-refresh"
            aria-label="새로고침"
            data-i18n-attr-aria-label="common.refresh"
            title="새로고침"
            data-i18n-attr-title="common.refresh"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="23 4 23 10 17 10"></polyline>
              <polyline points="1 20 1 14 7 14"></polyline>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
          </button>
          <button
            type="button"
            class="sk-btn sk-btn-primary"
            id="sk-list-add"
            data-i18n="survey.kvk.list.addButton"
          >등록 / 수정</button>
        </div>
      </header>

      <!-- 정렬 컨트롤 바 — PC/모바일 공용. 모바일에선 이모지 안내(legend) 도 함께 노출. -->
      <div class="sk-controls">
        <div class="sk-legend">
          <span class="sk-legend-item"><span class="sk-legend-emoji">⭐</span>
            <span data-i18n="survey.kvk.list.thead.general">공용</span></span>
          <span class="sk-legend-item"><span class="sk-legend-emoji">🛡️</span>
            <span data-i18n="survey.kvk.list.thead.training">병사</span></span>
          <span class="sk-legend-item"><span class="sk-legend-emoji">🔨</span>
            <span data-i18n="survey.kvk.list.thead.construction">건설</span></span>
        </div>
        <div class="sk-sort-bar">
          <button type="button" class="sk-sort-chip" data-sort="general"
            data-i18n="survey.kvk.list.thead.general">공용</button>
          <button type="button" class="sk-sort-chip" data-sort="training"
            data-i18n="survey.kvk.list.thead.training">병사</button>
          <button type="button" class="sk-sort-chip" data-sort="construction"
            data-i18n="survey.kvk.list.thead.construction">건설</button>
          <button type="button" class="sk-sort-chip" data-sort="total"
            data-i18n="survey.kvk.list.thead.total">합계</button>
          <button type="button" class="sk-sort-chip sk-sort-chip-score" data-sort="score">
            <span class="sk-sort-chip-emoji" aria-hidden="true">🎁</span>
            <span data-i18n="survey.kvk.list.sortScore">점수</span>
          </button>
          <button type="button" class="sk-sort-chip" data-sort="updated_at"
            data-i18n="survey.kvk.list.sortRegistered">등록순</button>
        </div>
      </div>

      <!-- 잠금 placeholder — .sk-page.is-unlocked 일 땐 CSS 로 숨김 -->
      <div class="sk-locked-card" id="sk-locked-card">
        <div class="sk-locked-title" data-i18n="survey.kvk.locked.title">
          🔒 현황 열람이 잠겨있습니다
        </div>
        <p class="sk-locked-body" data-i18n="survey.kvk.locked.body">
          [등록 / 수정] 을 완료하면 다른 참가자들의 제출 현황을 볼 수 있어요.
        </p>
      </div>

      <div class="sk-table-wrap">
        <table class="sk-table" id="sk-table">
          <thead>
            <tr>
              <th class="sk-th sk-th-rank" data-i18n="survey.kvk.list.thead.rank">#</th>
              <th class="sk-th sk-th-player" data-i18n="survey.kvk.list.thead.player">참가자</th>
              <th class="sk-th sk-th-num" data-i18n="survey.kvk.list.thead.general">공용</th>
              <th class="sk-th sk-th-num" data-i18n="survey.kvk.list.thead.training">병사</th>
              <th class="sk-th sk-th-num" data-i18n="survey.kvk.list.thead.construction">건설</th>
              <th class="sk-th sk-th-num sk-th-total" data-i18n="survey.kvk.list.thead.total">합계</th>
              <th class="sk-th sk-th-time" data-i18n="survey.kvk.list.thead.updated">등록시간</th>
            </tr>
          </thead>
          <tbody id="sk-tbody"></tbody>
        </table>
        <div class="sk-empty" id="sk-empty" hidden data-i18n="survey.kvk.list.empty">
          아직 제출된 데이터가 없어요. 첫 번째 참가자가 되어 주세요!
        </div>
        <div class="sk-loading" id="sk-loading" data-i18n="common.loading">로딩 중...</div>
      </div>
    </section>

    <!-- (D-1) 행 클릭 시 상세 다이얼로그 (읽기 전용) -->
    <dialog class="sk-dialog" id="sk-detail-dialog" aria-labelledby="sk-detail-title">
      <div class="sk-dialog-card">
        <header class="sk-dialog-head">
          <strong id="sk-detail-title" data-i18n="survey.kvk.detail.title">상세 정보</strong>
          <button
            type="button"
            class="sk-dialog-close"
            id="sk-detail-close"
            aria-label="Close"
          >&times;</button>
        </header>
        <div class="sk-dialog-body">
          <div class="sk-player-card" id="sk-detail-player">
            <div class="sk-player-photo-wrap">
              <div class="sk-player-photo-empty" id="sk-detail-photo-empty">?</div>
              <img class="sk-player-photo" id="sk-detail-photo" src="" alt="" hidden />
            </div>
            <div class="sk-player-meta">
              <div class="sk-player-name" id="sk-detail-name">-</div>
              <div class="sk-player-id" id="sk-detail-id">-</div>
            </div>
            <div class="sk-detail-time" id="sk-detail-updated">-</div>
          </div>

          <div class="sk-detail-bars">
            <div class="sk-detail-bar">
              <div class="sk-detail-bar-head">
                <span class="sk-detail-bar-label"><span class="sk-detail-emoji">⭐</span>
                  <span data-i18n="survey.kvk.form.general">공용 가속권</span></span>
                <span class="sk-detail-bar-value" id="sk-detail-general">-</span>
              </div>
              <div class="sk-detail-bar-track">
                <div class="sk-detail-bar-fill" id="sk-detail-bar-general"></div>
              </div>
              <div class="sk-detail-bar-pct" id="sk-detail-pct-general">-</div>
            </div>
            <div class="sk-detail-bar">
              <div class="sk-detail-bar-head">
                <span class="sk-detail-bar-label"><span class="sk-detail-emoji">🛡️</span>
                  <span data-i18n="survey.kvk.form.training">병사 훈련 가속권</span></span>
                <span class="sk-detail-bar-value" id="sk-detail-training">-</span>
              </div>
              <div class="sk-detail-bar-track">
                <div class="sk-detail-bar-fill" id="sk-detail-bar-training"></div>
              </div>
              <div class="sk-detail-bar-pct" id="sk-detail-pct-training">-</div>
            </div>
            <div class="sk-detail-bar">
              <div class="sk-detail-bar-head">
                <span class="sk-detail-bar-label"><span class="sk-detail-emoji">🔨</span>
                  <span data-i18n="survey.kvk.form.construction">건설 가속권</span></span>
                <span class="sk-detail-bar-value" id="sk-detail-construction">-</span>
              </div>
              <div class="sk-detail-bar-track">
                <div class="sk-detail-bar-fill" id="sk-detail-bar-construction"></div>
              </div>
              <div class="sk-detail-bar-pct" id="sk-detail-pct-construction">-</div>
            </div>
          </div>

          <hr class="sk-detail-divider" />

          <div class="sk-detail-total">
            <span class="sk-detail-total-label" data-i18n="survey.kvk.list.thead.total">합계</span>
            <span class="sk-detail-total-value" id="sk-detail-total">-</span>
          </div>

          <hr class="sk-detail-divider" />

          <!-- KvK 예상 점수 — PLAN.md 의 계산식 (1일차 건설 / 4일차 훈련+공용) -->
          <div class="sk-detail-scores">
            <h5 class="sk-detail-scores-title">
              <span data-i18n="survey.kvk.detail.scores.title">KvK 예상 점수</span>
              <span class="sk-detail-scores-note" data-i18n="survey.kvk.detail.scores.errorNote">오차 ±5%</span>
            </h5>
            <div class="sk-detail-score">
              <div class="sk-detail-score-head">
                <span class="sk-detail-score-label" data-i18n="survey.kvk.detail.scores.day1Label">🏗️ 1일차 (건설)</span>
                <span class="sk-detail-score-value" id="sk-detail-day1-value">-</span>
              </div>
              <div class="sk-detail-score-meta" id="sk-detail-day1-range">-</div>
            </div>
            <div class="sk-detail-score">
              <div class="sk-detail-score-head">
                <span class="sk-detail-score-label" data-i18n="survey.kvk.detail.scores.day4Label">⚔️ 4일차 (훈련 + 공용)</span>
                <span class="sk-detail-score-value" id="sk-detail-day4-value">-</span>
              </div>
              <div class="sk-detail-score-meta" id="sk-detail-day4-range">-</div>
            </div>
          </div>
        </div>
      </div>
    </dialog>

    <!-- (D-2) 도움말 이미지 lightbox — 아무 곳이나 클릭하면 닫힘 -->
    <dialog class="sk-image-dialog" id="sk-image-dialog" aria-label="가속권 현황 화면 예시">
      <img
        class="sk-image-dialog-img"
        src="/images/survey/speedup-stats.png"
        alt="게임 내 가속권 현황 화면"
        loading="lazy"
      />
    </dialog>
  </div>

  <script>
    import '@/scripts/pages/survey-kvk';
  </script>
</SurveyLayout>
